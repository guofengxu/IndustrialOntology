<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.industrial-ontology.org/test/pizza#"
     xml:base="http://www.industrial-ontology.org/test/pizza"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#">
    <owl:Ontology rdf:about="http://www.industrial-ontology.org/test/pizza">
        <owl:versionIRI rdf:resource="http://www.industrial-ontology.org/test/pizza/1.0"/>
        <dc:creator>IndustrialOntology</dc:creator>
        <rdfs:comment xml:lang="en">A pizza ontology written for the IndustrialOntology kernel acceptance tests. It follows the shape of the classic pizza tutorial ontology (named pizzas, toppings, bases, defined classes, value partitions and an enumerated country class) but is not a copy of it.</rdfs:comment>
        <rdfs:label xml:lang="en">Pizza test ontology</rdfs:label>
        <owl:versionInfo>1.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/elements/1.1/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator"/>
    


    <!-- http://www.industrial-ontology.org/test/pizza#pizzaNote -->

    <owl:AnnotationProperty rdf:about="http://www.industrial-ontology.org/test/pizza#pizzaNote">
        <rdfs:label xml:lang="en">pizza note</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.w3.org/2004/02/skos/core#altLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#prefLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.industrial-ontology.org/test/pizza#hasBase -->

    <owl:ObjectProperty rdf:about="http://www.industrial-ontology.org/test/pizza#hasBase">
        <rdfs:subPropertyOf rdf:resource="http://www.industrial-ontology.org/test/pizza#hasIngredient"/>
        <owl:inverseOf rdf:resource="http://www.industrial-ontology.org/test/pizza#isBaseOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.industrial-ontology.org/test/pizza#Pizza"/>
        <rdfs:range rdf:resource="http://www.industrial-ontology.org/test/pizza#PizzaBase"/>
        <rdfs:label xml:lang="en">has base</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.industrial-ontology.org/test/pizza#hasCountryOfOrigin -->

    <owl:ObjectProperty rdf:about="http://www.industrial-ontology.org/test/pizza#hasCountryOfOrigin">
        <rdfs:range rdf:resource="http://www.industrial-ontology.org/test/pizza#Country"/>
        <rdfs:label xml:lang="en">has country of origin</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.industrial-ontology.org/test/pizza#hasIngredient -->

    <owl:ObjectProperty rdf:about="http://www.industrial-ontology.org/test/pizza#hasIngredient">
        <owl:inverseOf rdf:resource="http://www.industrial-ontology.org/test/pizza#isIngredientOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.industrial-ontology.org/test/pizza#Food"/>
        <rdfs:range rdf:resource="http://www.industrial-ontology.org/test/pizza#Food"/>
        <rdfs:label xml:lang="en">has ingredient</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.industrial-ontology.org/test/pizza#hasSpiciness -->

    <owl:ObjectProperty rdf:about="http://www.industrial-ontology.org/test/pizza#hasSpiciness">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.industrial-ontology.org/test/pizza#Spiciness"/>
        <rdfs:label xml:lang="en">has spiciness</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.industrial-ontology.org/test/pizza#hasTopping -->

    <owl:ObjectProperty rdf:about="http://www.industrial-ontology.org/test/pizza#hasTopping">
        <rdfs:subPropertyOf rdf:resource="http://www.industrial-ontology.org/test/pizza#hasIngredient"/>
        <owl:inverseOf rdf:resource="http://www.industrial-ontology.org/test/pizza#isToppingOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.industrial-ontology.org/test/pizza#Pizza"/>
        <rdfs:range rdf:resource="http://www.industrial-ontology.org/test/pizza#PizzaTopping"/>
        <rdfs:label xml:lang="en">has topping</rdfs:label>
        <rdfs:label xml:lang="zh">有配料</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.industrial-ontology.org/test/pizza#isBaseOf -->

    <owl:ObjectProperty rdf:about="http://www.industrial-ontology.org/test/pizza#isBaseOf">
        <rdfs:subPropertyOf rdf:resource="http://www.industrial-ontology.org/test/pizza#isIngredientOf"/>
        <rdfs:label xml:lang="en">is base of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.industrial-ontology.org/test/pizza#isIngredientOf -->

    <owl:ObjectProperty rdf:about="http://www.industrial-ontology.org/test/pizza#isIngredientOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label xml:lang="en">is ingredient of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.industrial-ontology.org/test/pizza#isToppingOf -->

    <owl:ObjectProperty rdf:about="http://www.industrial-ontology.org/test/pizza#isToppingOf">
        <rdfs:subPropertyOf rdf:resource="http://www.industrial-ontology.org/test/pizza#isIngredientOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">is topping of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.industrial-ontology.org/test/pizza#hasCalorificContentValue -->

    <owl:DatatypeProperty rdf:about="http://www.industrial-ontology.org/test/pizza#hasCalorificContentValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.industrial-ontology.org/test/pizza#Food"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="en">has calorific content value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.industrial-ontology.org/test/pizza#hasDiameterInCentimetres -->

    <owl:DatatypeProperty rdf:about="http://www.industrial-ontology.org/test/pizza#hasDiameterInCentimetres">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.industrial-ontology.org/test/pizza#Pizza"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">45</xsd:maxInclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:label xml:lang="en">has diameter in centimetres</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.industrial-ontology.org/test/pizza#American -->

    <owl:Class rdf:about="http://www.industrial-ontology.org/test/pizza#American">
        <rdfs:subClassOf rdf:resource="http://www.industrial-ontology.org/test/pizza#NamedPizza"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.industrial-ontology.org/test/pizza#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.industrial-ontology.org/test/pizza#MozzarellaTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.industrial-ontology.org/test/pizza#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.industrial-ontology.org/test/pizza#PepperoniTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.industrial-ontology.org/test/pizza#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.industrial-ontology.org/test/pizza#TomatoTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.industrial-ontology.org/test/pizza#hasTopping"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.industrial-ontology.org/test/pizza#MozzarellaTopping"/>
                            <rdf:Description rdf:about="http://www.industrial-ontology.org/test/pizza#PepperoniTopping"/>
                            <rdf:Description rdf:about="http://www.industrial-ontology.org/test/pizza#TomatoTopping"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.industrial-ontology.org/test/pizza#hasCountryOfOrigin"/>
                <owl:hasValue rdf:resource="http://www.industrial-ontology.org/test/pizza#America"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">American</rdfs:label>
    </owl:Class>
    


    <!-- http://www.industrial-ontology.org/test/pizza#AmericanHot -->

    <owl:Class rdf:about="http://www.industrial-ontology.org/test/pizza#AmericanHot">
        <rdfs:subClassOf rdf:resource="http://www.industrial-ontology.org/test/pizza#NamedPizza"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.industrial-ontology.org/test/pizza#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.industrial-ontology.org/test/pizza#JalapenoPepperTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.industrial-ontology.org/test/pizza#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.industrial-ontology.org/test/pizza#MozzarellaTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.industrial-ontology.org/test/pizza#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.industrial-ontology.org/test/pizza#PepperoniTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.industrial-ontology.org/test/pizza#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.industrial-ontology.org/test/pizza#TomatoTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.industrial-ontology.org/test/pizza#hasTopping"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.industrial-ontology.org/test/pizza#JalapenoPepperTopping"/>
                            <rdf:Description rdf:about="http://www.industrial-ontology.org/test/pizza#MozzarellaTopping"/>
                            <rdf:Description rdf:about="http://www.industrial-ontology.org/test/pizza#PepperoniTopping"/>
                            <rdf:Description rdf:about="http://www.industrial-ontology.org/test/pizza#TomatoTopping"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.industrial-ontology.org/test/pizza#hasCountryOfOrigin"/>
                <owl:hasValue rdf:resource="http://www.industrial-ontology.org/test/pizza#America"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">American Hot</rdfs:label>
    </owl:Class>
    


    <!-- http://www.industrial-ontology.org/test/pizza#AnchoviesTopping -->

    <owl:Class rdf:about="http://www.industrial-ontology.org/test/pizza#AnchoviesTopping">
        <rdfs:subClassOf rdf:resource="http://www.industrial-ontology.org/test/pizza#FishTopping"/>
        <owl:disjointWith rdf:resource="http://www.industrial-ontology.org/test/pizza#TunaTopping"/>
        <rdfs:label xml:lang="en">Anchovies Topping</rdfs:label>
    </owl:Class>
    


    <!-- http://www.industrial-ontology.org/test/pizza#ArtichokeTopping -->

    <owl:Class rdf:about="http://www.industrial-ontology.org/test/pizza#ArtichokeTopping">
        <rdfs:subClassOf rdf:resource="http://www.industrial-ontology.org/test/pizza#VegetableTopping"/>
        <rdfs:label xml:lang="en">Artichoke Topping</rdfs:label>
    </owl:Class>
    


    <!-- http://www.industrial-ontology.org/test/pizza#CaperTopping -->

    <owl:Class rdf:about="http://www.industrial-ontology.org/test/pizza#CaperTopping">
        <rdfs:subClassOf rdf:resource="http://www.industrial-ontology.org/test/pizza#VegetableTopping"/>
        <rdfs:label xml:lang="en">Caper Topping</rdfs:label>
    </owl:Class>
    


    <!-- http://www.industrial-ontology.org/test/pizza#Capricciosa -->

    <owl:Class rdf:about="http://www.industrial-ontology.org/test/pizza#Capricciosa">
        <rdfs:subClassOf rdf:resource="http://www.industrial-ontology.org/test/pizza#NamedPizza"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.industrial-ontology.org/test/pizza#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.industrial-ontology.org/test/pizza#ArtichokeTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.industrial-ontology.org/test/pizza#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.industrial-ontology.org/test/pizza#HamTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.industrial-ontology.org/test/pizza#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.industrial-ontology.org/test/pizza#MozzarellaTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.industrial-ontology.org/test/pizza#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.industrial-ontology.org/test/pizza#MushroomTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.industrial-ontology.org/test/pizza#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.industrial-ontology.org/test/pizza#OliveTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.industrial-ontology.org/test/pizza#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.industrial-ontology.org/test/pizza#TomatoTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.industrial-ontology.org/test/pizza#hasTopping"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.industrial-ontology.org/test/pizza#ArtichokeTopping"/>
                            <rdf:Description rdf:about="http://www.industrial-ontology.org/test/pizza#HamTopping"/>
                            <rdf:Description rdf:about="http://www.industrial-ontology.org/test/pizza#MozzarellaTopping"/>
                            <rdf:Description rdf:about="http://www.industrial-ontology.org/test/pizza#MushroomTopping"/>
                            <rdf:Description rdf:about="http://www.industrial-ontology.org/test/pizza#OliveTopping"/>
                            <rdf:Description rdf:about="http://www.industrial-ontology.org/test/pizza#TomatoTopping"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Capricciosa</rdfs:label>
    </owl:Class>
    


    <!-- http://www.industrial-ontology.org/test/pizza#CheeseTopping -->

    <owl:Class rdf:about="http://www.industrial-ontology.org/test/pizza#CheeseTopping">
        <rdfs:subClassOf rdf:resource="http://www.industrial-ontology.org/test/pizza#PizzaTopping"/>
        <rdfs:label xml:lang="en">Cheese Topping</rdfs:label>
        <rdfs:label xml:lang="zh">奶酪配料</rdfs:label>
    </owl:Class>
    


    <!-- http://www.industrial-ontology.org/test/pizza#CheesyPizza -->

    <owl:Class rdf:about="http://www.industrial-ontology.org/test/pizza#CheesyPizza">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.industrial-ontology.org/test/pizza#Pizza"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.industrial-ontology.org/test/pizza#hasTopping"/>
                        <owl:someValuesFrom rdf:resource="http://www.industrial-ontology.org/test/pizza#CheeseTopping"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">Cheesy Pizza</rdfs:label>
    </owl:Class>
    


    <!-- http://www.industrial-ontology.org/test/pizza#Country -->

    <owl:Class rdf:about="http://www.industrial-ontology.org/test/pizza#Country">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.industrial-ontology.org/test/pizza#America"/>
                    <rdf:Description rdf:about="http://www.industrial-ontology.org/test/pizza#England"/>
                    <rdf:Description rdf:about="http://www.industrial-ontology.org/test/pizza#France"/>
                    <rdf:Description rdf:about="http://www.industrial-ontology.org/test/pizza#Germany"/>
                    <rdf:Description rdf:about="http://www.industrial-ontology.org/test/pizza#Italy"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.industrial-ontology.org/test/pizza#DomainConcept"/>
        <rdfs:label xml:lang="en">Country</rdfs:label>
        <rdfs:label xml:lang="zh">国家</rdfs:label>
    </owl:Class>
    


    <!-- http://www.industrial-ontology.org/test/pizza#DeepPanBase -->

    <owl:Class rdf:about="http://www.industrial-ontology.org/test/pizza#DeepPanBase">
        <rdfs:subClassOf rdf:resource="http://www.industrial-ontology.org/test/pizza#PizzaBase"/>
        <owl:disjointWith rdf:resource="http://www.industrial-ontology.org/test/pizza#ThinAndCrispyBase"/>
        <rdfs:label xml:lang="en">Deep Pan Base</rdfs:label>
    </owl:Class>
    


    <!-- http://www.industrial-ontology.org/test/pizza#Diavola -->

    <owl:Class rdf:about="http://www.industrial-ontology.org/test/pizza#Diavola">
        <rdfs:subClassOf rdf:resource="http://www.industrial-ontology.org/test/pizza#NamedPizza"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.industrial-ontology.org/test/pizza#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.industrial-ontology.org/test/pizza#JalapenoPepperTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.industrial-ontology.org/test/pizza#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.industrial-ontology.org/test/pizza#MozzarellaTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.industrial-ontology.org/test/pizza#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.industrial-ontology.org/test/pizza#SalamiTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.industrial-ontology.org/test/pizza#hasTopping"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.industrial-ontology.org/test/pizza#JalapenoPepperTopping"/>
                            <rdf:Description rdf:about="http://www.industrial-ontology.org/test/pizza#MozzarellaTopping"/>
                            <rdf:Description rdf:about="http://www.industrial-ontology.org/test/pizza#SalamiTopping"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Diavola</rdfs:label>
    </owl:Class>
    


    <!-- http://www.industrial-ontology.org/test/pizza#DomainConcept -->

    <owl:Class rdf:about="http://www.industrial-ontology.org/test/pizza#DomainConcept">
        <rdfs:label xml:lang="en">Domain Concept</rdfs:label>
    </owl:Class>
    


    <!-- http://www.industrial-ontology.org/test/pizza#FishTopping -->

    <owl:Class rdf:about="http://www.industrial-ontology.org/test/pizza#FishTopping">
        <rdfs:subClassOf rdf:resource="http://www.industrial-ontology.org/test/pizza#PizzaTopping"/>
        <rdfs:label xml:lang="en">Fish Topping</rdfs:label>
