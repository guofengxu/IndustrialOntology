<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.industrial.ontology</groupId>
        <artifactId>industrial-ontology-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>wp-api</artifactId>
    <name>wp-api</name>
    <description>Spring MVC controllers /api/v1, legacy /data layer, SSE, OpenAPI, security config.</description>

    <dependencies>
        <dependency>
            <groupId>org.industrial.ontology</groupId>
            <artifactId>wp-app</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- docs/01 §6: Keycloak JWTs (resource server), API keys and the local fallback login in one stateless chain. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <!-- /v3/api-docs: every endpoint carries @Tag/@Operation (docs/00 §7 rule 6); the UI comes with P1-15. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- MongoTestServer (wp-app test jar): the services behind the security chain read the legacy collections. -->
        <dependency>
            <groupId>org.industrial.ontology</groupId>
            <artifactId>wp-app</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mongodb</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.bwaldvogel</groupId>
            <artifactId>mongo-java-server</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- OidcTestServer: Keycloak with the deploy realm where Docker runs, an in-process issuer otherwise. -->
        <dependency>
            <groupId>com.github.dasniko</groupId>
            <artifactId>testcontainers-keycloak</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <!-- The realm of deploy/docker-compose*.yml, so the tests run against the realm that ships. -->
            <testResource>
                <directory>${project.basedir}/../deploy/keycloak</directory>
                <targetPath>keycloak</targetPath>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-layering</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.industrial.ontology:*</exclude>
                                    </excludes>
                                    <includes>
                                        <include>org.industrial.ontology:wp-domain</include>
                                        <include>org.industrial.ontology:wp-kernel-api</include>
                                        <include>org.industrial.ontology:wp-kernel</include>
                                        <include>org.industrial.ontology:wp-app</include>
                                    </includes>
                                    <message>Layering: server -> api/integration/governance/ai -> app -> kernel -> kernel-api -> domain (docs/00 §2). wp-api may depend on wp-app and below only.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
