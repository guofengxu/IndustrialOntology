<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.industrial.ontology</groupId>
        <artifactId>industrial-ontology-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>wp-kernel-api</artifactId>
    <name>wp-kernel-api</name>
    <description>OWL change model, index, revision and hierarchy interfaces.</description>

    <dependencies>
        <dependency>
            <groupId>org.industrial.ontology</groupId>
            <artifactId>wp-domain</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-layering</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.industrial.ontology:*</exclude>
                                        <exclude>org.springframework*:*</exclude>
                                    </excludes>
                                    <includes>
                                        <include>org.industrial.ontology:wp-domain</include>
                                    </includes>
                                    <message>Layering: server -> api/integration/governance/ai -> app -> kernel -> kernel-api -> domain (docs/00 §2). wp-kernel-api may depend on wp-domain only, and not on Spring.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
