<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.industrial.ontology</groupId>
        <artifactId>industrial-ontology-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>wp-app</artifactId>
    <name>wp-app</name>
    <description>Feature application services, Spring Data Mongo repositories, permissions, event bus.</description>

    <dependencies>
        <dependency>
            <groupId>org.industrial.ontology</groupId>
            <artifactId>wp-kernel</artifactId>
        </dependency>

        <!-- Project runtime (docs/01 §2, §3.4): auto-configuration, KernelExecutors, ProjectRegistry over Caffeine. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Kernel test fixtures (InMemoryProjectPorts, ProjectKernelFixture) for loading real projects. -->
        <dependency>
            <groupId>org.industrial.ontology</groupId>
            <artifactId>wp-kernel</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-layering</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.industrial.ontology:*</exclude>
                                    </excludes>
                                    <includes>
                                        <include>org.industrial.ontology:wp-domain</include>
                                        <include>org.industrial.ontology:wp-kernel-api</include>
                                        <include>org.industrial.ontology:wp-kernel</include>
                                    </includes>
                                    <message>Layering: server -> api/integration/governance/ai -> app -> kernel -> kernel-api -> domain (docs/00 §2). wp-app may depend on wp-kernel and below only.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
