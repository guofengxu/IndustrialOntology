<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.industrial.ontology</groupId>
        <artifactId>industrial-ontology-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>wp-cli</artifactId>
    <name>wp-cli</name>
    <description>Admin commands: create-admin, generate-api-key, rebuild-permissions, migrate-mongo.</description>

    <dependencies>
        <dependency>
            <groupId>org.industrial.ontology</groupId>
            <artifactId>wp-app</artifactId>
        </dependency>
        <!-- Commands are picocli @Command beans run by a Spring Boot CommandLineRunner (docs/01 §8). -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- MongoTestServer and the legacy Mongo samples. -->
        <dependency>
            <groupId>org.industrial.ontology</groupId>
            <artifactId>wp-app</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mongodb</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.bwaldvogel</groupId>
            <artifactId>mongo-java-server</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- An executable jar of its own: java -jar wp-cli.jar <command> (docs/01 §8). -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- The integration tests run after repackage, so they take the classes, not the executable jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-layering</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.industrial.ontology:*</exclude>
                                    </excludes>
                                    <includes>
                                        <include>org.industrial.ontology:wp-domain</include>
                                        <include>org.industrial.ontology:wp-kernel-api</include>
                                        <include>org.industrial.ontology:wp-kernel</include>
                                        <include>org.industrial.ontology:wp-app</include>
                                    </includes>
                                    <message>Layering: server -> api/integration/governance/ai -> app -> kernel -> kernel-api -> domain (docs/00 §2). wp-cli may depend on wp-app and below only.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
